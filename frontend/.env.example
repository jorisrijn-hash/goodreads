# Frontend environment. Copy to .env.local for local development.
#
# Both variables are SERVER-ONLY and deliberately not NEXT_PUBLIC_. A NEXT_PUBLIC_
# variable is compiled into the browser bundle; exposing the API host there is exactly
# what would make the session cookie third-party. The browser calls /api/v1/... and
# /covers/... on this app's own origin, and Next.js rewrites them.

# Where the Spring API lives.
API_ORIGIN=http://localhost:8080

# Where cover bytes live, as a full base URL including any path prefix.
# Unset it locally: covers are then served by the API from disk.
#
# Production (Supabase Storage, public bucket):
#   COVERS_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/book-covers
#
# This is a public read-only asset URL, not a credential. Storage WRITE credentials
# (the S3 access key and secret) belong only to the upload tooling and must never
# appear in frontend configuration.
# COVERS_BASE_URL=
