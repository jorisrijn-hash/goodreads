# Copy to .env and adjust. .env is gitignored and must never be committed.

# --- Database ---------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/goodreads
DATABASE_USER=goodreads
DATABASE_PASSWORD=goodreads_dev
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/goodreads_test

# --- Backend ----------------------------------------------------------------
PORT=8080

# --- Frontend ---------------------------------------------------------------
# Server-side base URL used by React Server Components to reach the API.
API_BASE_URL=http://localhost:8080

# --- Ingest (Checkpoint B) --------------------------------------------------
# Open Library asks identified clients to send a contact address; doing so
# raises the rate limit from 1 req/s to 3 req/s.
OPENLIBRARY_USER_AGENT=goodreads-redesign/0.1 (you@example.com)
